SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Email Configuration ───────────────────────────────────────────────────
# For local development, leave EMAIL_BACKEND as console (prints to stdout)
# For production, use: django.core.mail.backends.smtp.EmailBackend or sendgrid_backend.SendgridBackend

# Console Backend (Default - Local Dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Backend (Gmail, Outlook, etc.)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@tourbooking.com

# SendGrid Backend (Production Recommended)
# EMAIL_BACKEND=sendgrid_backend.SendgridBackend
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_SANDBOX_MODE_IN_DEBUG=False

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:5173

# ─── AWS S3 Configuration (Optional) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ─── Auth Settings ─────────────────────────────────────────────────────────
AUTH_TOKEN_EXPIRY_HOURS=72
